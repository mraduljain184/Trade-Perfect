# Copy this file to ".env" (same folder) and fill in the CHANGE_ME values.
# NEVER commit .env - it holds passwords and keys.

# --- PostgreSQL (used by docker-compose to create the database) ---
POSTGRES_USER=tradeperfect
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=tradeperfect

# --- Backend ---
# Inside docker-compose the host name is "db". To run the backend WITHOUT docker, use "localhost".
DATABASE_URL=postgresql+psycopg://tradeperfect:CHANGE_ME_db_password@db:5432/tradeperfect
# Long random string, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_long_random_string_at_least_32_chars
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173
# Password given to every seeded demo user (min 8 characters)
SEED_DEFAULT_PASSWORD=CHANGE_ME_demo_password
SEED_EMAIL_DOMAIN=tradeperfect.local
MODEL_DIR=ml_artifacts
DATA_DIR=/data
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# --- Email (optional; leave empty = emails are only logged) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@tradeperfect.local

# --- Chatbot LLM (optional; leave empty = keyword fallback) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
